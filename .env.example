# qwen3.8-flash 中转调用配置模板 —— 复制成 .env 后填入真实 token(.env 不入库)
# 依据:qianwneuse.md(Anthropic Messages API 格式,实测 2026-09-16)
# ⚠️ 用 Bearer token 时不要再设 ANTHROPIC_API_KEY,否则 SDK 会同时发两个鉴权头
QWEN_BASE_URL=https://code.fabrique.cn
QWEN_ENDPOINT=/v1/messages
QWEN_MODEL=qwen3.8-flash
QWEN_AUTH_TOKEN=sk-你的token
QWEN_ANTHROPIC_VERSION=2023-06-01
QWEN_MAX_TOKENS=2048
